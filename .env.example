# Server-only. Keep actual values in .env (ignored by Git).
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Desktop OAuth client. npm run youtube:authorize writes the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional, used only by the local collector process.
STUDIO_URL=http://localhost:5173

# Production bridge: copy server values to .dev.vars / deployment secrets.
# Never use NEXT_PUBLIC_ / VITE_ for these keys.
PRODUCTION_ENABLED=false
PRODUCTION_UPLOAD_ENABLED=false
# Local Sites dev sign-in uses local_seedy. Remote owner must match /workflow.
PRODUCTION_OWNER_ID=local_seedy
PRODUCTION_WORKER_TOKEN=
PRODUCTION_DAILY_JOB_LIMIT=3
# Worker process only; choose models available in YOUR provider project.
PRODUCTION_APP_URL=http://127.0.0.1:5173
OPENAI_API_KEY=
PRODUCTION_TEXT_MODEL=
PRODUCTION_IMAGE_MODEL=
PRODUCTION_TTS_MODEL=
PRODUCTION_TTS_VOICE=
PRODUCTION_WORK_DIR=.production-worker
# npm run youtube:authorize-upload writes this separate token.
GOOGLE_UPLOAD_REFRESH_TOKEN=
# Optional: PRODUCTION_PYTHON=.venv-production/bin/python
# Optional: PRODUCTION_FONT=/absolute/path/to/JapaneseFont.ttc

# Server-only. Keep actual values in .env (ignored by Git).
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Desktop OAuth client. npm run youtube:authorize writes the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional, used only by the local collector process.
STUDIO_URL=http://localhost:5173
